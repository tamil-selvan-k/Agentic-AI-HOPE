# ==============================================================================
# Environment Configuration - Event Registration Assistant
# ==============================================================================

# 1. LLM Provider (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Supabase Online Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
# Connection URI for PostgreSQL database (Settings -> Database -> Connection String)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# 3. Local SQLite Fallback DB paths (used for zero-dependency offline tests/demos)
AGENT_DB=agent.db
EVENT_DB=event.db
